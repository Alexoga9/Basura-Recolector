### Godot 4 ###
# Carpeta de caché/importación y estado del editor (se regenera sola)
# OJO: antes estaba como "[.godot]", que en gitignore es una clase de
# caracteres y NO ignoraba la carpeta.
.godot/

# Godot 3 (por si acaso)
.import/

# Presets de exportación (rutas locales y posibles credenciales/keystores)
export.cfg
export_presets.cfg

# Temporales y traducciones generadas desde CSV
*.tmp
*.translation

# Mono / C#
.mono/
data_*/
mono_crash.*.json

# Salidas de exportación
*.exe
*.pck
*.apk
*.aab
*.dmg
build/
builds/
export/
exports/

# Archivos de respaldo de otras herramientas
*.blend1
*.bak
*.backup
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDEs externos
.vscode/
.idea/
*.swp
*.swo

# NOTA: NO ignorar los *.uid ni los *.import. Godot 4.4+ los necesita
# versionados para que las referencias entre recursos no se rompan.
