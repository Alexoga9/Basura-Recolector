[gd_resource type="ShaderMaterial" format=3 uid="uid://dh8ldak1ngnox"]

[sub_resource type="Shader" id="Shader_p7o5q"]
code = "shader_type canvas_item;

uniform vec4 outline_color : source_color = vec4(1.0);
//Blinking modulates the base color.
//Set blink_time_scale to 0 if you don't want blinking.
uniform vec4 blink_color : source_color = vec4(1.0);
uniform float blink_time_scale : hint_range(0.0, 10.0, 0.1) = 0.0;

// Nuevas variables para controlar el área del outline
uniform bool enable_area_restriction = true;
uniform vec2 outline_area_min = vec2(0.0, 0.0);  // Esquina inferior izquierda
uniform vec2 outline_area_max = vec2(1.0, 1.0);  // Esquina superior derecha
uniform bool invert_area = false;  // Si es true, el outline SOLO se dibuja en el área

void fragment() {
	vec2 pixel_size = TEXTURE_PIXEL_SIZE;
	bool within = texture(TEXTURE, UV + pixel_size * vec2(1.0, 0.0)).a > 0.0;
	within = within || texture(TEXTURE, UV + pixel_size * vec2(1.0, 1.0)).a > 0.0;
	within = within || texture(TEXTURE, UV + pixel_size * vec2(1.0, -1.0)).a > 0.0;
	within = within || texture(TEXTURE, UV + pixel_size * vec2(0.0, -1.0)).a > 0.0;
	within = within || texture(TEXTURE, UV + pixel_size * vec2(0.0, 1.0)).a > 0.0;
	within = within || texture(TEXTURE, UV + pixel_size * vec2(-1.0, 1.0)).a > 0.0;
	within = within || texture(TEXTURE, UV + pixel_size * vec2(-1.0, -1.0)).a > 0.0;
	within = within || texture(TEXTURE, UV + pixel_size * vec2(-1.0, 0.0)).a > 0.0;
	
	bool outline = within && texture(TEXTURE, UV).a == 0.0;
	
	// Verificar si el pixel actual está dentro del área permitida
	bool in_area = UV.x >= outline_area_min.x && UV.x <= outline_area_max.x &&
	               UV.y >= outline_area_min.y && UV.y <= outline_area_max.y;
	
	// Aplicar restricción de área
	if (enable_area_restriction) {
		if (invert_area) {
			// Solo dibujar outline dentro del área
			outline = outline && in_area;
		} else {
			// No dibujar outline dentro del área (efecto de agujero)
			outline = outline && !in_area;
		}
	}
	
	COLOR = mix(COLOR, COLOR * blink_color, 0.5 - 0.5 * cos(TIME * blink_time_scale));
	COLOR = float(!outline) * COLOR + float(outline) * outline_color;
}"

[resource]
shader = SubResource("Shader_p7o5q")
shader_parameter/outline_color = Color(1, 1, 1, 1)
shader_parameter/blink_color = Color(1, 1, 1, 1)
shader_parameter/blink_time_scale = 0.0
shader_parameter/enable_area_restriction = true
shader_parameter/outline_area_min = Vector2(0, 0.875)
shader_parameter/outline_area_max = Vector2(1, 1)
shader_parameter/invert_area = false
